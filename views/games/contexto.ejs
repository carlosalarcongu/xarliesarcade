<div id="contextoScreen" class="hidden">
        <div class="back-nav">
            <button onclick="app.goBackToHub()" style="flex:0.3; background:#eb4d4b;">⬅</button>
            <button onclick="app.contexto.showRanking()" style="flex:1; background:#a55eea; color:#222; font-weight:bold;">🏆 Ranking</button>
        </div>
        
        <h2 style="color:#a55eea; margin-bottom:5px;">🧠 Contexto</h2>
        
        <div style="background:#222; padding:10px; border-radius:10px; margin-bottom:15px; display:flex; align-items:center; justify-content:center; gap:10px;">
            <span style="color:#aaa; font-size:0.9em;">Juego N°:</span>
            <input type="number" id="ctxGameId" style="width:80px; margin:0; padding:5px; height:auto;">
            <button onclick="app.contexto.changeGameId()" style="background:#57606f; width:auto; padding:5px 10px; margin:0;">🔄</button>
        </div>

        <div id="contextoWinner" class="hidden" style="width:100%; text-align:center; padding:15px; background:#2ed573; color:#fff; border-radius:10px; margin-bottom:15px; font-weight:bold; animation:pulse 1s infinite;"></div>

        <div class="card" style="background:#222; border: 2px solid #a55eea; padding: 15px; border-radius: 10px; margin-bottom: 20px; width: 100%;">
            <div style="display:flex; gap:10px; margin-bottom: 10px;">
                <input type="text" id="contextoInput" placeholder="Escribe una palabra..." style="margin:0; flex:1; padding: 10px; border-radius: 5px; border: none; outline:none;" autocomplete="off">
                <button onclick="app.contexto.submit()" class="main-btn" style="width:auto; margin:0; padding:0 20px; background:#a55eea;">➜</button>
            </div>
            <div id="contextoLatestGuess"></div>
        </div>

        <h3 style="color:#aaa; text-align:left; width:100%; border-bottom:1px solid #444; padding-bottom:5px; margin-bottom: 15px;">Historial Ordenado</h3>
        <div id="contextoList" style="width: 100%; display: flex; flex-direction: column; gap: 8px; margin-bottom: 50px;"></div>
    </div>

<div id="contextoRankingModal" class="hidden modal-overlay" style="align-items: center; justify-content: flex-start; padding-top: 50px;">
        <div class="card" style="width: 90%; max-width: 400px; max-height: 80vh; overflow-y: auto; background:#2f3542; border: 2px solid #a55eea;">
            <h2 style="color:#a55eea;">🏆 RANKING SEMANAL</h2>
            <div style="text-align:left; font-size:0.8em; color:#aaa; margin-bottom:15px;">
                🔴 Roja: +1 pts | 🟠 Naranja: +5 pts<br>
                🟢 Verde: +20 pts | 🎉 Victoria: +500 pts
            </div>
            <div id="contextoRankingList" style="text-align:left;">Cargando...</div>
            
            <button id="btnWipeRanking" onclick="app.contexto.resetRanking()" class="kick-btn hidden" style="margin-top:20px; font-size:0.8em;">🗑️ Borrar Todo (Admin)</button>
            <button onclick="app.contexto.closeRanking()" class="main-btn" style="margin-top:10px;">Cerrar</button>
        </div>
    </div>

