<div id="tierlistScreen" class="hidden" style="width: 100%; max-width: 800px;">
    <div class="back-nav" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <button onclick="app.goBackToHub(false)" style="padding: 8px 15px; margin: 0;">⬅</button>
        
        <h2 style="margin: 0; font-size: 1.5em; flex: 1; text-align: center;">Tierlist</h2>
        
        <div style="display:flex; gap: 10px; align-items: center;">
            <label id="tierlistAdminControls" class="hidden" style="color:var(--text-muted); font-size:0.8em; display:flex; align-items:center; gap:5px; cursor:pointer;">
                <input type="checkbox" id="tierlistEnableEdit" onchange="app.tierlist.render()"> Mod
                <input type="checkbox" id="tierlistEnableDelete" onchange="app.tierlist.render()"> Borrar
            </label>
            <button id="tierlistViewBtn" onclick="app.tierlist.toggleView()" style="background:var(--accent-blue); color:white; border:none; margin:0; padding: 8px 15px; min-width: 50px;">All</button>
        </div>
    </div>
    
    <div class="tier-board"><div class="tier-row">
        <div class="tier-label" style="background:#ffd700; color:#000; font-size:0.75em; line-height:1.1; text-align:center;">Sneaky<br>Gold<span class="lock-toggle" onclick="app.tierlist.unlockTier('SG')">🔒</span></div><div class="tier-drop" id="tier-SG"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#ff4757;">S</div><div class="tier-drop" id="tier-S"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#ffa502;">A</div><div class="tier-drop" id="tier-A"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#f1c40f;">B</div><div class="tier-drop" id="tier-B"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#2ed573;">C</div><div class="tier-drop" id="tier-C"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#74b9ff;">F</div><div class="tier-drop" id="tier-F"></div></div>
        <div class="tier-row"><div class="tier-label" style="background:#6d4c41; color:#fff; font-size:0.75em; line-height:1.1; text-align:center;">Sneaky<br>Shit<span class="lock-toggle" onclick="app.tierlist.unlockTier('SS')">🔒</span></div><div class="tier-drop" id="tier-SS"></div></div>
    </div>
    
    <h3 style="margin-top:20px;">Pendientes de clasificar por ti:</h3>
    <div class="unrated-zone" id="tier-UNRATED"></div>

    <div id="tierMoveModal" class="modal-overlay hidden" style="z-index: 99999; align-items: center; justify-content: center; padding: 10px;">
        <div id="tierMoveCard" class="card" style="width: 100%; max-width: 350px; height: 90vh; background-size: cover; background-position: center; position: relative; border: 2px solid var(--border-input); display: flex; flex-direction: column;">
            <div id="tierMoveBackground" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background-size: cover; background-position: center;"></div>
            <div id="tierMoveOverlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1; transition: opacity 0.3s;"></div>

            <button id="tierExtendedBack" onclick="app.tierlist.toggleExtended()" class="hidden" style="position: absolute; top: 10px; left: 10px; z-index: 10; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 8px 12px; border-radius: 5px; cursor: pointer;">⬅</button>

            <div id="tierMoveScroll" style="position: relative; z-index: 2; overflow-y: auto; padding: 20px; flex-grow: 1;">
                <div id="tierMoveUI">
                    <div id="tierMovePreviewNormal" style="margin-bottom: 15px; text-align: center; font-weight: bold; font-size: 1.1em; color: #fff; text-shadow: 0 2px 2px #000;"></div>
                    <h3 style="color:#fff; margin-bottom:15px; text-align:center; text-shadow: 0 2px 2px #000;">Mover a...</h3>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                        <button onclick="app.tierlist.moveToTier('SG')" style="background:rgba(255, 215, 0, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px; grid-column: span 2;">Sneaky Gold</button>
                        <button onclick="app.tierlist.moveToTier('S')" style="background:rgba(255, 71, 87, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">S</button>
                        <button onclick="app.tierlist.moveToTier('A')" style="background:rgba(255, 165, 2, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">A</button>
                        <button onclick="app.tierlist.moveToTier('B')" style="background:rgba(241, 196, 15, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">B</button>
                        <button onclick="app.tierlist.moveToTier('C')" style="background:rgba(46, 213, 115, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">C</button>
                        <button onclick="app.tierlist.moveToTier('F')" style="background:rgba(116, 185, 255, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">F</button>
                        <button onclick="app.tierlist.moveToTier('SS')" style="background:rgba(109, 76, 65, 0.6); color:#fff; padding:12px; font-weight:bold; border:none; border-radius:5px;">Sneaky Shit</button>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
                        <button onclick="app.tierlist.moveToTier('UNRATED')" style="background:rgba(127, 140, 141, 0.6); color:#fff; padding:12px; font-size:0.9em; border:none; border-radius:5px;">Pendientes</button>
                        <button onclick="app.tierlist.toggleExtended()" style="background:rgba(0,0,0,0.5); color:#fff; padding:10px; border:1px solid rgba(255,255,255,0.2); border-radius:5px;">Ver extendido</button>
                        <button onclick="document.getElementById('tierMoveModal').classList.add('hidden')" style="background:rgba(0,0,0,0.5); color:#fff; padding:10px; border:1px solid rgba(255,255,255,0.2); border-radius:5px;">Cancelar</button>
                    </div>
                </div>
            </div>

            <div id="tierMovePreviewExtended" class="hidden" style="position: absolute; bottom: 20px; left: 10px; right: 10px; z-index: 3; padding: 15px; background: rgba(0, 0, 0, 0.15); border-radius: 12px; text-align: center; color: #fff; border: 1px solid rgba(255,255,255,0.1);"></div>
        </div>
    </div>

    <div id="tierEditModal" class="modal-overlay hidden" style="z-index: 99999;">
        <div class="card" style="max-width: 400px; padding: 20px;">
            <h3 style="color:var(--text-main); margin-bottom:15px;">Editar Frase</h3>
            <textarea id="tierEditInput" style="width:100%; height:100px; padding:10px; border-radius:5px; background:var(--bg-main); color:var(--text-main); border:2px solid var(--accent-blue);"></textarea>
            <div style="display:flex; gap:10px; margin-top:15px;">
                <button onclick="document.getElementById('tierEditModal').classList.add('hidden')" style="flex:1; background:transparent; color:var(--text-muted); padding:10px; border:1px solid var(--border-input); border-radius:5px;">Cancelar</button>
                <button onclick="app.tierlist.saveEditQuote()" style="flex:1; background:var(--accent-blue); color:white; padding:10px; border-radius:5px;">Guardar</button>
            </div>
        </div>
    </div>
</div>