<div id="musScreen" class="hidden" style="width: 100%;">
    
    <div class="back-nav" style="display: flex; justify-content: flex-start; width: 100%; margin-bottom: 15px;">
        <button onclick="app.goBackToHub()" class="mus-glass-btn">⬅ Volver</button>
    </div>
    
    <h2 style="margin-bottom: 10px; text-align: center;">🐄 Registro de Mus</h2>

    <div class="mus-room-header" style="margin-bottom: 15px; width: 100%;">
        <div class="room-controls" style="display: flex; gap: 10px; width: 100%; align-items: center;">
            <select id="musRoomSelect" onchange="app.mus.changeRoom()" style="flex: 1; font-size: 1em; margin: 0;"></select>
            <button onclick="app.mus.createRoom()" style="background: #27ae60; color: white; width: auto; padding: 10px 15px; font-weight: bold; border-radius: var(--btn-radius);">+</button>
            <button onclick="app.mus.toggleControls()" class="mus-glass-btn" style="width: auto; padding: 10px 15px; margin: 0; display: flex; align-items: center; justify-content: center;">🖊️</button>
        </div>
    </div>
    
    <div id="musControlsArea" class="hidden" style="background: rgba(0,0,0,0.2); padding: 10px; border-radius: 10px; border: 1px dashed #e1b12c; margin-bottom: 15px; width: 100%;">
        <div style="display: flex; justify-content: center; gap: 10px; width: 100%;">
            <button class="kick-btn" style="flex: 1; font-size: 0.8em; margin: 0;" onclick="app.mus.addPlayer()">+ Jugador</button>
            <button class="kick-btn" style="flex: 1; font-size: 0.8em; margin: 0;" onclick="app.mus.showAddMatchModal()">+ Partida</button>
        </div>
    </div>

    <div class="card" style="padding: 15px; margin-bottom: 15px; background: #222; border: 1px solid #444; width: 100%;">
        <div style="display: flex; gap: 10px; margin-bottom: 10px; width: 100%;">
            <div style="flex: 1; text-align: left;">
                <label style="color: #aaa; font-size: 0.8em;">Periodo:</label>
                <select id="musPeriodFilter" onchange="app.mus.changeView()" style="width: 100%; font-size: 0.9em; margin-top: 5px;">
                    <option value="all" selected>Siempre</option>
                    <option value="7days">Últimos 7 días</option>
                    <option value="30days">Últimos 30 días</option>
                    <option value="year">Este año</option>
                </select>
            </div>
            <div style="flex: 2; text-align: left;">
                <label style="color: #aaa; font-size: 0.8em;">Vista:</label>
                <select id="musViewMode" onchange="app.mus.changeView()" style="width: 100%; font-size: 0.9em; margin-top: 5px;">
                    <option value="ranking_pair">🏆 Ranking Parejas</option>
                    <option value="ranking_player" selected>👤 Ranking Individual</option>
                    <option value="recent_log">📝 Historial Partidas</option>
                    <option value="examinar_persona">🔬 Examinar Persona</option>
                    <option value="examinar_pareja">🔬 Examinar Pareja</option>
                </select>
            </div>
        </div>
        
        <div id="divExamPlayer" class="hidden" style="margin-top: 10px; text-align: left; width: 100%;">
            <label style="color: white;">Persona:</label>
            <select id="musExamPlayer" onchange="app.mus.runAnalysis()" style="width: 100%; margin-bottom: 5px;"></select>
            <label style="color: white;">Analizar:</label>
            <select id="musExamTypeP" onchange="app.mus.runAnalysis()" style="width: 100%;">
                <option value="vs_win">Evolución % Victorias</option>
                <option value="best_partner">🤝 Mejor Compañero</option>
                <option value="best_rival">⚔️ Mejor Rival</option>
            </select>
        </div>

        <div id="divExamPair" class="hidden" style="margin-top: 10px; text-align: left; width: 100%;">
            <label style="color: white;">Selecciona la Pareja:</label>
            <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                <select id="musExamPair1" onchange="app.mus.updateExamPairSelects()" style="flex: 1; padding: 5px; border-radius: 5px; color: #000;"></select>
                <select id="musExamPair2" onchange="app.mus.runAnalysis()" style="flex: 1; padding: 5px; border-radius: 5px; color: #000;"></select>
            </div>
            <label style="color: white;">Analizar:</label>
            <select id="musExamTypePair" onchange="app.mus.runAnalysis()" style="width: 100%;">
                <option value="vs_pair_win">Evolución % Victorias</option>
                <option value="vs_pair_performance">🆚 Desempeño vs Rivales</option>
            </select>
        </div>

        <div id="musChartSection" class="hidden" style="margin-top: 15px; height: 200px; width: 100%;">
            <canvas id="musChartCanvas" style="width: 100%; height: 100%;"></canvas>
        </div>
    </div>

    <div id="musStatsContainer" style="text-align: center; width: 100%;"></div>

    <div id="musLogContainer" class="hidden" style="width: 100%;"></div>

    <div id="musTournamentArea" class="hidden" style="width: 100%; text-align: left;">
        <div class="card" style="background:#222; border: 2px solid #e1b12c; margin-bottom: 20px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div style="flex:1;">
                    <h3 id="musTName" style="color:#e1b12c; margin:0;">Nombre Torneo</h3>
                    <p id="musTInfo" style="color:#aaa; font-size:0.8em; margin:5px 0;">Fase: ...</p>
                    <p id="musTDesc" style="color:#ccc; font-size:0.8em; margin:5px 0; font-style:italic;"></p>
                </div>
                <div id="musTAdminControls" class="hidden" style="display:flex; flex-direction:column; gap:5px;">
                    <button onclick="app.mus.startTournament()" class="start-btn" style="padding:5px 15px; font-size:0.8em; width:auto; margin:0;">▶️ Iniciar Torneo</button>
                    <button onclick="app.mus.advanceToBracket()" id="musTAdvanceBtn" class="kick-btn hidden" style="background:#9b59b6; padding:5px 15px; font-size:0.8em; width:auto; margin:0;">🏆 Pasar a Eliminatorias</button>
                    <button onclick="app.mus.downloadPDF()" class="kick-btn" style="background:#3498db; padding:5px 15px; font-size:0.8em; width:auto; margin:0;">📄 Generar PDF</button>
                    <button onclick="app.mus.deleteTournament()" class="kick-btn" style="background:#e74c3c; padding:5px 15px; font-size:0.8em; width:auto; margin:0;">🗑️ Eliminar Torneo</button>
                </div>
            </div>
        </div>

        <div id="musTContent" style="width:100%; overflow-x:auto;"></div>
    </div>

    <div id="musAddMatchModal" class="hidden modal-overlay" style="align-items: center; padding-top: 20px; overflow-y: auto; z-index: 100000;">
        <div class="card" style="background: var(--bg-card); padding: 15px; border-radius: var(--card-radius); width: 95%; max-width: 400px; border: 2px solid var(--mus-input-border); box-shadow: var(--card-shadow-3d);">
            <h3 style="margin-top: 0; color: #e1b12c; font-size: 1.3em;">Anotar Partida</h3>
            <p id="matchRoomIndicator" style="color: var(--text-muted); font-size: 0.75em; margin-bottom: 15px;">Sala: ...</p>
            
            <div style="display: flex; justify-content: space-between; align-items: stretch; gap: 5px; margin-bottom: 15px;">
                <div style="flex: 1; min-width: 0; text-align: center; background: var(--bg-blue-tint); padding: 10px 4px; border-radius: var(--btn-radius); border: 1px solid var(--accent-blue); display: flex; flex-direction: column;">
                    <h4 style="margin: 0 0 5px 0; color: var(--accent-blue); font-size: 0.85em;">Pareja 1</h4>
                    <select id="musP1" style="width: 100%; margin: 2px 0; padding: 6px 2px; font-size: 0.8em; border-radius: var(--btn-radius);"></select>
                    <select id="musP2" style="width: 100%; margin: 2px 0; padding: 6px 2px; font-size: 0.8em; border-radius: var(--btn-radius);"></select>
                    
                    <div style="display: flex; align-items: center; justify-content: space-evenly; margin-top: auto; padding-top: 10px;">
                        <button style="width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%; font-size: 1.2em; font-weight: bold; background: var(--accent-red); color: white; border: none; box-shadow: 0 3px 0 rgba(0,0,0,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1;" onclick="app.mus.changeScore(1, -1)">-</button>
                        <span id="musS1" style="font-weight: 900; font-size: 1.5em; color: var(--text-main); width: 25px; display: inline-block; text-align: center;">0</span>
                        <button style="width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%; font-size: 1.2em; font-weight: bold; background: var(--accent-green); color: white; border: none; box-shadow: 0 3px 0 rgba(0,0,0,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1;" onclick="app.mus.changeScore(1, 1)">+</button>
                    </div>
                </div>
                
                <div style="font-weight: bold; color: var(--text-muted); font-size: 0.8em; align-self: center; padding: 0 2px;">VS</div>
                
                <div style="flex: 1; min-width: 0; text-align: center; background: var(--bg-red-tint); padding: 10px 4px; border-radius: var(--btn-radius); border: 1px solid var(--accent-red); display: flex; flex-direction: column;">
                    <h4 style="margin: 0 0 5px 0; color: var(--accent-red); font-size: 0.85em;">Pareja 2</h4>
                    <select id="musP3" style="width: 100%; margin: 2px 0; padding: 6px 2px; font-size: 0.8em; border-radius: var(--btn-radius);"></select>
                    <select id="musP4" style="width: 100%; margin: 2px 0; padding: 6px 2px; font-size: 0.8em; border-radius: var(--btn-radius);"></select>
                    
                    <div style="display: flex; align-items: center; justify-content: space-evenly; margin-top: auto; padding-top: 10px;">
                        <button style="width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%; font-size: 1.2em; font-weight: bold; background: var(--accent-red); color: white; border: none; box-shadow: 0 3px 0 rgba(0,0,0,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1;" onclick="app.mus.changeScore(2, -1)">-</button>
                        <span id="musS2" style="font-weight: 900; font-size: 1.5em; color: var(--text-main); width: 25px; display: inline-block; text-align: center;">0</span>
                        <button style="width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%; font-size: 1.2em; font-weight: bold; background: var(--accent-green); color: white; border: none; box-shadow: 0 3px 0 rgba(0,0,0,0.2); cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1;" onclick="app.mus.changeScore(2, 1)">+</button>
                    </div>
                </div>
            </div>
            
            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button onclick="document.getElementById('musAddMatchModal').classList.add('hidden')" class="main-btn" style="flex: 1; background: var(--border-input); box-shadow: 0 4px 0 rgba(0,0,0,0.2); padding: 12px; margin: 0;">Cancelar</button>
                <button onclick="app.mus.submitMatch()" class="main-btn" style="flex: 1; background: #e1b12c; color: #222; box-shadow: 0 4px 0 rgba(0,0,0,0.2); padding: 12px; margin: 0;">Guardar</button>
            </div>
        </div>
    </div>

    <div id="musCreateRoomModal" class="hidden modal-overlay" style="align-items:flex-start; padding-top:30px; overflow-y:auto; z-index: 100000;">
        <div class="card" style="width:95%; max-width:400px; background:#2f3542; border:2px solid #27ae60; text-align:left;">
            <h2 style="color:#27ae60; margin-top:0;">➕ Nueva Sala</h2>
            
            <label style="color:white; font-weight:bold; font-size:0.9em;">Nombre de la Sala / Torneo:</label>
            <input type="text" id="mcRoomName" placeholder="Ej: Torneo Verano" style="width:100%; margin-bottom:15px; padding:10px; border-radius:5px;">

            <label style="display:flex; align-items:center; gap:10px; color:#e1b12c; font-weight:bold; margin-bottom:15px;">
                <input type="checkbox" id="mcIsTournament" onchange="document.getElementById('mcTournamentConfig').classList.toggle('hidden', !this.checked)" style="width:20px; height:20px;">
                ESTA SALA ES UN TORNEO 🏆
            </label>

            <div id="mcTournamentConfig" class="hidden" style="background:#1e272e; padding:15px; border-radius:10px; margin-bottom:15px;">
                <label style="color:#aaa; font-size:0.8em;">Descripción del Torneo (opcional):</label>
                <textarea id="mcDescription" placeholder="Ej: Torneo amistoso de verano..." style="width:100%; height:60px; padding:8px; margin-bottom:15px; border-radius:5px; font-family:monospace; font-size:0.9em;"></textarea>

                <label style="color:#74b9ff; font-size:0.85em; display:block; margin-bottom:5px;">Formato:</label>
                <select id="mcFormat" onchange="document.getElementById('mcGroupConfig').classList.toggle('hidden', this.value !== 'GROUPS')" style="width:100%; padding:8px; margin-bottom:15px; border-radius:5px;">
                    <option value="BRACKET">Directo a Eliminatorias (Cuadro)</option>
                    <option value="GROUPS">Fase de Grupos + Eliminatorias</option>
                </select>

                <div id="mcGroupConfig" class="hidden" style="display:flex; gap:10px; margin-bottom:15px;">
                    <div style="flex:1;">
                        <label style="color:#aaa; font-size:0.8em;">Nº Grupos:</label>
                        <input type="number" id="mcNumGroups" value="2" min="1" max="8" style="width:100%; padding:5px; text-align:center;">
                    </div>
                    <div style="flex:1;">
                        <label style="color:#aaa; font-size:0.8em;">Vueltas (Ida/Vuelta):</label>
                        <input type="number" id="mcMatchesRival" value="1" min="1" max="4" style="width:100%; padding:5px; text-align:center;">
                    </div>
                </div>

                <label style="display:flex; align-items:center; gap:5px; color:#ccc; font-size:0.85em; margin-bottom:10px;">
                    <input type="checkbox" id="mcRandPairs" checked=""> Formar parejas al azar con los inscritos.
                </label>
                <label style="display:flex; align-items:center; gap:5px; color:#ccc; font-size:0.85em;">
                    <input type="checkbox" id="mcRandBracket" checked=""> Sortear cruces / grupos al azar.
                </label>
                <p style="font-size:0.7em; color:#ff7675; margin-top:10px;">*Podrás asignar parejas y grupos manualmente después de cerrar inscripciones.</p>
            </div>

            <div style="display:flex; gap:10px;">
                <button onclick="document.getElementById('musCreateRoomModal').classList.add('hidden')" class="kick-btn" style="flex:1;">Cancelar</button>
                <button onclick="app.mus.submitCreateRoom()" class="main-btn" style="flex:1; background:#27ae60;">Crear Sala</button>
            </div>
        </div>
    </div>
</div>

<div id="musVueApp" class="hidden" style="width: 100%; min-height: 100vh;"></div>