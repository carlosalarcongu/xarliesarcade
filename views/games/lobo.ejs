<div id="loboLobby" class="hidden">
        <div class="back-nav" style="display:flex; gap:5px;">
            <button onclick="app.showRules()" style="flex:0.3; background:#ffa502; color:#2f3542; font-weight:900; font-size:1.2em;">❓</button>
            <button onclick="app.goBackToHub(true)" style="flex:1; background:#eb4d4b;">❌ Salir</button>
        </div>        
        <h2 style="color:#74b9ff">🐺 Sala El Lobo</h2>
        <div id="loboAdminPanel" class="admin-panel hidden">
            <div class="control-row">
                <button onclick="app.lobo.adj('wolvesCount',-1)">-</button>
                <span>Lobos: <span id="val_wolvesCount">2</span></span>
                <button onclick="app.lobo.adj('wolvesCount',1)">+</button>
            </div>
            <div class="category-grid">
                <button class="cat-btn" id="btn_hasSeer" onclick="app.lobo.tog('hasSeer')">🔮 Vidente<br><span id="val_hasSeer">SI</span></button>
                <button class="cat-btn" id="btn_hasGirl" onclick="app.lobo.tog('hasGirl')">👧 Niña<br><span id="val_hasGirl">NO</span></button>
                <button class="cat-btn" id="btn_hasCupid" onclick="app.lobo.tog('hasCupid')">💘 Cupido<br><span id="val_hasCupid">NO</span></button>
                <button class="cat-btn" id="btn_hasHunter" onclick="app.lobo.tog('hasHunter')">🔫 Cazador<br><span id="val_hasHunter">NO</span></button>
                <button class="cat-btn" id="btn_hasWitch" onclick="app.lobo.tog('hasWitch')">🧙‍♀️ Bruja<br><span id="val_hasWitch">SI</span></button>
                <button class="cat-btn" id="btn_hasSheriff" onclick="app.lobo.tog('hasSheriff')">⭐ Alguacil<br><span id="val_hasSheriff">SI</span></button>
            </div>
            <button class="start-btn" onclick="app.lobo.start()">🌙 EMPEZAR</button>
        </div>
        <p id="loboWaitMsg" style="color:#aaa">Esperando al admin...</p>
        <h3>Aldeanos (<span id="loboPlayerCount">0</span>)</h3>
        <ul id="loboPlayerList" style="margin-top:20px"></ul>
    </div>

<div id="loboGame" class="hidden">
        <div class="back-nav" style="display:flex; gap:5px;">
            <button onclick="app.showRules()" style="flex:0.3; background:#ffa502; color:#2f3542; font-weight:900; font-size:1.2em;">❓</button>
            <button onclick="app.goBackToHub(true)" style="flex:1; background:#eb4d4b;">❌ Salir</button>
        </div>        
        <div style="text-align:center; margin-bottom:15px; background:#2f3542; padding:10px; border-radius:10px; border:2px solid #74b9ff">
            <h2 id="loboPhaseTitle" style="margin:0; color:#fff">...</h2>
            <p id="loboPhaseDesc" style="margin:5px 0 0 0; color:#aaa; font-size:0.9em">...</p>
        </div>
        <div id="loboCard" class="blur-content" onclick="app.lobo.toggleRole()" style="margin-bottom: 20px;">
            <h1>Tu Rol</h1>
            <div id="loboRoleTitle" style="font-size:2.5em; font-weight:bold; color:white;">...</div>
            <p id="loboRoleDesc" style="color:#ccc;">...</p>
            <div id="loboWolfPartners" class="hidden" style="background:#2d3436; padding:10px; border-radius:5px; margin-top:10px;">
                <strong style="color:#ff7675">Compañeros:</strong><br>
                <span id="loboPartnersText"></span>
            </div>
        </div>
        <div class="card-note">👆 Toca para ver tu rol discretamente</div>
        <div id="loboNightActionArea" class="hidden" style="width:100%; margin-bottom:20px; border: 2px dashed #a29bfe; padding:10px; border-radius:10px;"></div>
        <button id="btnLoboPhaseAction" onclick="app.lobo.sendPhaseAction()" class="main-btn" style="background:#6c5ce7; margin-bottom:10px;">
            Me duermo 💤
        </button>
        <p id="loboWaitingText" style="text-align:center; color:#aaa; display:none; margin-bottom:10px;">Esperando al resto...</p>
        <div id="loboTimeline" class="timeline-container"></div>
        <div id="loboDaySection" class="hidden">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 style="color:#74b9ff; margin:0">🗳️ Pueblo</h3>
                <button id="loboClearVotesBtn" class="kick-btn hidden" style="width:auto; padding:5px 10px; font-size:0.8em; background:#555" onclick="app.lobo.clearVotes()">Limpiar</button>
            </div>
            <div id="loboVoteGrid" class="vote-grid"></div>
        </div>
        <button onclick="app.lobo.reset()" class="kick-btn hidden" id="loboResetBtn" style="margin-top:20px; width:100%;">Resetear Partida</button>
        <div id="loboWinModal" class="hidden modal-overlay" style="justify-content: flex-start; padding-top: 50px; overflow-y: auto;">
            <h1 id="loboWinTitle" style="font-size:3em; margin-bottom: 20px;">VICTORIA</h1>
            <div style="background:#2f3542; padding:15px; border-radius:10px; width:100%; max-width: 400px; border: 2px solid #57606f;">
                <h3>Resumen de la Partida</h3>
                <div id="loboWinList" style="text-align:left; margin-top: 15px;"></div>
            </div>
            <button onclick="app.lobo.reset()" class="main-btn" style="margin-top:20px; width: auto; padding: 15px 30px;">Nueva Partida</button>
        </div>
    </div>

