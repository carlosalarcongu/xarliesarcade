<div id="darkstoriesScreen" class="hidden">
        <div class="back-nav" style="display:flex; justify-content:space-between; margin-bottom:20px;">
            <button onclick="app.goBackToHub(false)" style="background:#eb4d4b; padding:10px 20px; border-radius:10px; border:none; color:white; font-weight:bold; cursor:pointer;">❌ Salir</button>
            <h2 style="margin:0; color:#8c7ae6; line-height:1.5;">📖 Dark Stories</h2>
        </div>

        <div style="background:#222; padding:15px; border-radius:10px; margin-bottom:20px;">
            <div style="color:#aaa; font-size:0.9em; margin-bottom:10px;">Dificultad:</div>
            <div style="display:flex; gap:10px;">
                <button id="dsBtn_facil" onclick="app.darkstories.setCategory('facil')" style="flex:1; background:#2ed573; color:#000; font-weight:bold; padding:10px; border-radius:5px; border:none;">Fácil</button>
                <button id="dsBtn_medio" onclick="app.darkstories.setCategory('medio')" style="flex:1; background:#ffa502; color:#000; font-weight:bold; padding:10px; border-radius:5px; border:none;">Medio</button>
                <button id="dsBtn_dificil" onclick="app.darkstories.setCategory('dificil')" style="flex:1; background:#ff4757; color:#fff; font-weight:bold; padding:10px; border-radius:5px; border:none;">Difícil</button>
            </div>
            <div id="dsStats" style="margin-top:15px; font-size:0.8em; color:#aaa;">Cargando historias...</div>
        </div>

        <div class="card" style="background:#1e272e; border:2px solid #8c7ae6; padding:20px; text-align:left; border-radius:10px; min-height: 200px;">
            <div id="dsCardContent">
                </div>
        </div>

        <div id="dsCardControls" class="hidden" style="margin-top:20px;">
            <button id="dsBtnFlip" class="main-btn" onclick="app.darkstories.toggleFlip()" style="background:#8c7ae6; margin-bottom:15px;">👁️ Revelar Solución</button>
            
            <div style="display:flex; gap:10px; margin-bottom:15px;">
                <button id="dsBtnAcertada" onclick="app.darkstories.toggleAcertada()" style="flex:1; padding:12px; border-radius:5px; border:none; cursor:pointer;">✔️ Marcar Acertada</button>
                <button id="dsBtnAburrida" onclick="app.darkstories.toggleAburrida()" style="flex:1; padding:12px; border-radius:5px; border:none; cursor:pointer;">🥱 Marcar Aburrida</button>
            </div>

            <button class="main-btn" onclick="app.darkstories.drawCard()" style="background:#2f3542; color:#00cec9; border: 2px solid #00cec9;">⏭️ Sacar Nueva Tarjeta</button>
        </div>
    </div>

