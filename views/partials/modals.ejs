<div id="registerModal" class="modal-overlay hidden" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; display:flex; justify-content:center; align-items:center;">
        <div class="card" style="width:90%; max-width:350px; border: 2px solid #74b9ff; background: #2f3542;">
            <h3 style="color:#74b9ff; margin-bottom:10px;">📝 Registrar Nickname</h3>
            <p style="color:#aaa; font-size:0.8em; margin-bottom:15px;">Protege tu nombre con una contraseña para que nadie más pueda usarlo.</p>
            
            <label style="display:block; text-align:left; color:#aaa; font-size:0.8em; margin-bottom:5px;">Nickname:</label>
            <input type="text" id="regUsername" oninput="app.auth.checkAvailability()" placeholder="Nickname..." style="margin-bottom:5px; padding:10px; width:100%;">
            <div id="regStatus" style="font-size:0.8em; font-weight:bold; text-align:right; margin-bottom:15px; min-height:15px;"></div>

            <label style="display:block; text-align:left; color:#aaa; font-size:0.8em; margin-bottom:5px;">Contraseña:</label>
            <input type="password" id="regPassword" placeholder="********" style="margin-bottom:15px; padding:10px; width:100%;">

            <label style="display:block; text-align:left; color:#aaa; font-size:0.8em; margin-bottom:5px;">Email (Opcional, para recuperar):</label>
            <input type="text" id="regEmail" placeholder="correo@ejemplo.com" style="margin-bottom:20px; padding:10px; width:100%;">
            
            <div style="display:flex; gap:10px; justify-content:center;">
                <button onclick="app.auth.closeRegister()" style="background:#57606f; color:white; padding:10px; border:none; border-radius:5px; width:50%; font-weight:bold; cursor:pointer;">Cancelar</button>
                <button onclick="app.auth.submitRegistration()" style="background:#2ed573; color:white; padding:10px; border:none; border-radius:5px; width:50%; font-weight:bold; cursor:pointer;">Solicitar</button>
            </div>
        </div>
    </div>

<div id="passwordModal" class="modal-overlay hidden" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; display:flex; justify-content:center; align-items:center;">
        <div style="background:#2f3542; padding:20px; border-radius:10px; text-align:center; width:90%; max-width:300px; border: 2px solid #f1c40f;">
            <h3 style="color:#f1c40f; margin-bottom:15px;">👑 Cuenta Protegida</h3>
            <p style="color:#aaa; font-size:0.9em; margin-bottom:15px;">Introduce la contraseña para verificar tu identidad:</p>
            
            <input type="password" id="adminPasswordInput" placeholder="********" style="width:100%; padding:10px; margin-bottom:5px; border-radius:5px; border:none; text-align:center; font-size:1.2em;" onkeydown="if(event.key === 'Enter') app.submitPassword()">
            
            <div style="text-align: right; margin-bottom: 15px;">
                <span onclick="app.auth.openForgotPassword()" style="color:#74b9ff; font-size:0.8em; cursor:pointer; text-decoration:underline;">Olvidé la contraseña</span>
            </div>

            <div style="display:flex; gap:10px; justify-content:center;">
                <button onclick="app.cancelPassword()" style="background:#e74c3c; color:white; padding:10px; border:none; border-radius:5px; width:50%; font-weight:bold; cursor:pointer;">Cancelar</button>
                <button onclick="app.submitPassword()" style="background:#2ed573; color:white; padding:10px; border:none; border-radius:5px; width:50%; font-weight:bold; cursor:pointer;">Entrar</button>
            </div>
        </div>
    </div>

<div id="globalRulesModal" class="hidden modal-overlay" style="align-items: center; justify-content: center; z-index: 1000;">
        <div class="card" style="max-height: 80vh; overflow-y: auto; text-align: left; position: relative; border: 2px solid #ffa502;">
            <button onclick="document.getElementById('globalRulesModal').classList.add('hidden')" style="position: absolute; top: 10px; right: 10px; background: transparent; color: #ff4757; font-size: 1.5em; padding: 0; width: auto; box-shadow: none;">✖</button>
            <h2 style="color: #ffa502; text-align: center; margin-top: 0;">📖 REGLAS</h2>
            <div id="globalRulesText" style="white-space: pre-wrap; font-family: monospace; line-height: 1.5; color: #dfe6e9;">
                ...
            </div>
            <button onclick="document.getElementById('globalRulesModal').classList.add('hidden')" class="main-btn" style="margin-top: 20px;">Entendido</button>
        </div>
    </div>

<div id="floatingUserWidget" class="hidden" style="position:fixed; top:10px; right:10px; z-index:99999; background:rgba(44, 62, 80, 0.9); padding:8px 15px; border-radius:25px; border:1px solid #ffffff55; color:#fff; cursor:grab; box-shadow: 0 4px 10px rgba(0,0,0,0.5); text-align:right; font-size:0.85em; user-select:none; backdrop-filter:blur(5px); min-width:120px; touch-action: none;">
        <div id="floatingUserText">Cargando...</div>
    </div>

