    <div id="hubNewsWidget" class="card hidden" style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 400px; padding: 15px; border: 2px solid #a55eea; box-shadow: 0 10px 25px rgba(0,0,0,0.5); z-index: 1000; background: var(--bg-card);">
        <button onclick="app.dismissNews(event)" style="position: absolute; top: 5px; right: 10px; background: transparent; border: none; color: var(--text-muted); font-size: 1.2em; box-shadow: none; padding: 0;">✖</button>
