<div id="loginScreen" class="hidden">
        <div class="back-nav"><button onclick="app.goBackToHub()">⬅ Volver</button></div>
        
        <h1 id="loginTitle" style="color:#ffa502">Juego</h1>

        <div id="nameEntryArea" class="card">
            <p style="margin-bottom:10px;">¿Cómo te llamas?</p>
            <input type="text" id="username" placeholder="Tu nombre..." maxlength="18" autocomplete="off">
            
            <div style="text-align: right; margin-top: -10px; margin-bottom: 15px;">
                <span onclick="app.auth.openRegister()" style="color:#74b9ff; font-size:0.8em; font-weight:bold; cursor:pointer; text-decoration:underline;">📝 Registrar mi nombre</span>
            </div>

            <button class="main-btn" onclick="app.saveNameAndContinue()">GUARDAR</button>
        </div>

        <div id="roomSelectionArea" class="hidden" style="width: 100%;">
            <div class="card" style="border-color: #2ed573;">
                <p style="color:#aaa; font-size:0.9em; margin-bottom: 10px;">Hola, <strong id="displayName" style="color:white; font-size:1.2em">...</strong></p>
                <button class="main-btn" onclick="app.joinGame('NEW')" style="background: #2ed573; box-shadow: 0 5px 0 #218c74;">
                    ➕ CREAR NUEVA SALA
                </button>
            </div>

            <h3 style="margin-top:20px; color:#74b9ff;">Salas Activas</h3>
            <div id="gameActiveRooms" class="hub-grid">
                <p style="color:#666; font-style:italic;">Buscando salas...</p>
            </div>
        </div>

        <div id="loginRulesArea" class="rules-box hidden" style="margin-top:20px; border-left: 5px solid #ffa502; background: #2f3542; padding: 15px; text-align: left;">
            <h3 style="margin-top:0; color: #fff;">📖 Cómo se juega:</h3>
            <div id="loginRulesText" style="line-height: 1.4em; color: #ccc;">...</div>
        </div>
    </div>

